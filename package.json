{
  "name": "fastlbs",
  "version": "2.0.1",
  "description": "Enterprise-grade TypeScript CLI and framework for AWS Lambda. Optimizes cold starts with warm typed context, auto-generates OpenAPI 3.0 / Swagger docs from Zod, scaffolds IAM authorizers, syncs Serverless config, and builds with esbuild.",
  "main": "index.js",
  "type": "module",
  "bin": {
    "fastlbs": "./bin/fastlbs.js"
  },
