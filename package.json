    "bin",
    "src",
    "README.md",
    "README.es.md",
    "WHATS_NEW.md",
    "MIGRATION_GUIDE.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "npm run smoke",
    "smoke": "node --test tests/cli.smoke.test.js"
  },
  "keywords": [
    "aws",
    "aws-lambda",
    "lambda",
    "serverless",
    "serverless-framework",
    "serverless-offline",
    "typescript",
    "cold-start",
